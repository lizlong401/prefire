{
  "manifest_version": 3,
  "name": "Prefire \u2014 Saved Views",
  "version": "0.1.0",
  "description": "Save camera views in Adobe Firefly Boards and glide between them.",
  "minimum_chrome_version": "111",
  "permissions": [
    "storage"
  ],
  "content_scripts": [
    {
      "matches": [
        "https://firefly.adobe.com/*"
      ],
      "js": [
        "page.js",
        "inventory.js"
      ],
      "world": "MAIN",
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://firefly.adobe.com/*"
      ],
      "js": [
        "tryon-core.js",
        "tryon.js",
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "background": {
    "service_worker": "worker.js"
  },
  "host_permissions": [
    "http://127.0.0.1/*"
  ]
}
